    },
    {
      "source": "/profit",
      "destination": "/index.html"
    },
    {
      "source": "/regions",
      "destination": "/index.html"
    },
    {
      "source": "/forecast",
      "destination": "/index.html"
    },
    {
      "source": "/upload",
      "destination": "/index.html"
    },
    {
